[Unit]
Description=Bhumijo Gateway Service
Documentation=https://github.com/Bhumijo/bhumijo-gateway-linux
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bhumijo-gateway
Group=bhumijo-gateway
WorkingDirectory=/opt/bhumijo-gateway
EnvironmentFile=/etc/bhumijo-gateway/gateway.conf

ExecStart=/usr/bin/python3 /opt/bhumijo-gateway/gateway_service.py

Restart=on-failure
RestartSec=10
StartLimitInterval=60s
StartLimitBurst=3

StandardOutput=journal
StandardError=journal
SyslogIdentifier=bhumijo-gateway

# Security
NoNewPrivileges=true
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/log/bhumijo-gateway.log

[Install]
WantedBy=multi-user.target