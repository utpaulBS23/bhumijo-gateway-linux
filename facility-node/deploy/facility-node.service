[Unit]
Description=Facility node
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=facility
Group=facility
SupplementaryGroups=gpio i2c
# lgpio (reed switches) creates its notify pipe in the working directory, and
# /opt/facility-node is read-only here (ProtectSystem=strict): run from the
# service's private /tmp instead. Every path the node uses is absolute.
WorkingDirectory=/tmp
EnvironmentFile=/opt/facility-node/.env
Environment=GPIOZERO_PIN_FACTORY=lgpio
Environment=LG_WD=/tmp
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/facility-node/venv/bin/python /opt/facility-node/app.py
Restart=always
RestartSec=5

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/facility

[Install]
WantedBy=multi-user.target
