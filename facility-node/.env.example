# Copy to /opt/facility-node/.env (install.sh does this). Mode 640, never commit.
# Sections follow the node's three functions: 1 door, 2 camera, 3 odour.
FACILITY_ID=facility-001

# IP plan: router/gateway 192.168.10.1, Pi .104, relay .174, camera .149,
# air sensor board .105, QR scanners .101 (male) and .102 (female)

# ==== Functions ===========================================================
# Switch each function on (1) or off (0); all on when left out. An off
# function runs no jobs or checks, and its settings below may stay CHANGE_ME.
# Change with: facility feature <door|camera|odour> <on|off>
ENABLE_DOORS=1
ENABLE_CAMERA=1
ENABLE_ODOUR=1

# ==== Admin backend (all functions) =======================================
ADMIN_URL=https://your-admin-backend.com/api
ADMIN_KEY=CHANGE_ME
# PENDING backend confirmation: auth header and the 4 API paths
ADMIN_AUTH_HEADER=Authorization
ADMIN_AUTH_SCHEME=Bearer
SENSOR_PATH=/facility/sensor
DOOR_EVENT_PATH=/facility/door-event
ALERT_PATH=/facility/alert
TOKENS_PATH=/facility/tokens

# ==== 1. Door lock / unlock ===============================================
# KC868-A4S (password = POST_PASSWORD in the board's board_secrets.py)
RELAY_URL=http://192.168.10.174
RELAY_PWD=CHANGE_ME

# Doors: one per section. Each scanner opens only its own door (routed by
# scanner IP); any valid token works at either door. Scans from other IPs are
# rejected. EXIT_INPUT: 0 = Input01. REED_GPIO: BCM pin (needs REED=1).
# UNLOCK_SECONDS: how long a QR / app unlock keeps the door open, 1-30 s (the
# KC868 holds the relay that long; the exit button uses its timer module's own
# delay). Change with: facility door delay <door> <seconds>
DOORS=male,female
UNLOCK_SECONDS=5

DOOR_MALE_RELAY=1
DOOR_MALE_EXIT_INPUT=0
DOOR_MALE_REED_GPIO=27
DOOR_MALE_SCANNER_IPS=192.168.10.101
DOOR_MALE_UNLOCK_SECONDS=5

DOOR_FEMALE_RELAY=2
DOOR_FEMALE_EXIT_INPUT=1
DOOR_FEMALE_REED_GPIO=22
DOOR_FEMALE_SCANNER_IPS=192.168.10.102
DOOR_FEMALE_UNLOCK_SECONDS=5

# Reed switch (MC-38). REED=1 only if installed.
REED=0
REED_ACTIVE_HIGH=0
PROPPED_THRESHOLD=300
PROPPED_REPEAT=180

# Online QR validation (door/qr_api.py). Empty QR_API_URL = local token cache only.
# Paid entry (the backend charges per scan): QR_API_ORDER=api_only + the
# backend's charge URL here. Path under ADMIN_URL or a full URL. Test with the
# dummy API:
#   QR_API_URL=http://127.0.0.1:8090/qr/validate   and   QR_API_AUTH=0
QR_API_URL=
# POST sends a JSON body, GET sends query parameters
QR_API_METHOD=POST
# local_first: cache answers, API only for codes the cache doesn't know (default)
# api_first:   API decides (a "no" overrides the cache); cache only if API is down
# api_only:    paid entry. API decides every scan (balance); no internet = refused.
#              Pi-made staff codes (facility qr) and the Facility app still open
QR_API_ORDER=local_first
# seconds before giving up and using the cache
QR_API_TIMEOUT=3
# 1 = send the ADMIN_AUTH_HEADER/ADMIN_KEY header, 0 = no auth header
QR_API_AUTH=1
# request field names (empty = don't send that field)
QR_API_TOKEN_FIELD=token
QR_API_FACILITY_FIELD=facility
QR_API_DOOR_FIELD=door
# extra static fields as one-line JSON, e.g. {"device_token":"abc"}
QR_API_EXTRA=
# where the yes/no is in the reply (dot path), and which values mean yes
QR_API_ALLOW_FIELD=allowed
QR_API_ALLOW_VALUES=true,1,yes,granted,allow,allowed,success,ok
# HTTP codes that mean "code refused" (other errors fall back to the cache);
# 402 = no balance
QR_API_DENY_STATUS=400,402,403,404,410,422
# per-scan id field, also sent as the Idempotency-Key header: the backend
# must charge one scan once, however often it is asked (empty = header only)
QR_API_SCAN_ID_FIELD=scan_id
# where the reply says why it refused (logged as api_reason), e.g. insufficient_balance
QR_API_REASON_FIELD=reason
# same code at the same door within this many seconds = the same scan: no
# second API call or charge; an open door just stays open
QR_DEDUP_SECONDS=10

# What a scanner with a display shows after a scan (Rakinda Msg, and the
# "message" field of /qr and /qrscanner replies). Short, and plain ASCII if
# the scanner can't show other scripts. Empty = this default.
SCANNER_MSG_OPENED=Please Enter the facility
SCANNER_MSG_NO_BALANCE=Insufficient balance, please top up
SCANNER_MSG_OFFLINE=No internet, please try again
SCANNER_MSG_DENIED=Access denied
SCANNER_MSG_ERROR=Door error, please call the attendant

# Facility app button, "personal use": the purposes an attendant may pick
# (customer use = cash at the counter needs no purpose)
ATTENDANT_PURPOSES=cleaning,bath,toilet,maintenance

# Bench testing only: exposes POST /door/opened and /door/closed
DOOR_TEST_ENDPOINTS=0

# ==== 2. Camera monitoring ================================================
# Set up with: facility camera
CAM_HOST=192.168.10.149
CAM_RTSP=rtsp://user:pass@192.168.10.149:554/stream1

# Snapshot upload (PENDING backend endpoint). Empty = keep JPEGs on the Pi only.
# Multipart POST: field "file" + form fields facility, name, ts.
SNAPSHOT_UPLOAD_PATH=
SNAPSHOT_KEEP_DAYS=7
SNAPSHOT_DIR=/var/lib/facility/snapshots

# ==== 3. Odour monitoring =================================================
# Air sensors on a WiFi board (ESP32-S3 + ENS160 + AHT20, firmware/air-sensor).
# Empty = ENS160/AHT20 wired to the Pi's own I2C. SETUP.md section 6.1.
# Set up with: facility sensor
SENSOR_URL=
# seconds to wait for the board before reporting nulls
SENSOR_TIMEOUT=3

# Odour alert. Empty limit = that metric is off. Tune per site against real
# cleaning checks (SETUP.md section 6.4). Times in seconds.
# TVOC score 0-100 (0-20 very good, 21-40 good, 41-60 moderate, 61-80 dangerous,
# 81-100 very dangerous). 61 = alert from "dangerous" on.
ODOUR_TVOC_SCORE_LIMIT=61
# Raw ENS160 TVOC in ppb, as an alternative to the score (empty = off)
ODOUR_TVOC_LIMIT=
# ENS160 AQI 1-5 (4 = poor, 5 = unhealthy)
ODOUR_AQI_LIMIT=4
# MQ-135 ammonia, ppm (needs MQ=1 + MQ135_R0)
ODOUR_NH3_LIMIT=10
# MQ-136 H2S, ppm (needs MQ=1 + MQ136_R0)
ODOUR_H2S_LIMIT=1
# above limit this long -> odour_high
ODOUR_HOLD=600
# repeat while still high
ODOUR_REPEAT=1800
# below all limits this long -> odour_resolved
ODOUR_CLEAR_HOLD=300

# MQ-135 / MQ-136 via ADS1115 (optional). R0 values come from: facility mq calibrate
MQ=0
ADS1115_ADDR=0x48
# ADS1115 A0; "none" if not fitted
MQ135_CHANNEL=0
# ADS1115 A1; "none" if not fitted
MQ136_CHANNEL=1
MQ135_R0=
MQ136_R0=
# load resistor on the MQ module (often 10k "103" or 1k "102")
MQ_RL_KOHM=10
# AOUT divider ratio (10k/20k = 1.5)
MQ_DIVIDER=1.5

# ==== Local store =========================================================
DB_PATH=/var/lib/facility/facility.db
